---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";

const res = await fetch("https://security-news-blog-cms.onrender.com/api/posts");
const { data: posts }: { data: { slug: string; title: string; excerpt: string }[] } = await res.json();
---

<Layout title="Security News Blog">
	<ul class="space-y-10">
		{posts.map((post) => (
			<li>
				<PostCard slug={post.slug} title={post.title} excerpt={post.excerpt} />
			</li>
		))}
	</ul>
</Layout>
