---
import Layout from "../layouts/Layout.astro";
import PostList, { type Post } from "../components/PostList.astro";

const res = await fetch("https://security-news-blog-cms.onrender.com/api/posts?populate=createdBy");
const { data: posts }: { data: Post[] } = await res.json();
---

<Layout title="Security News Blog">
	<PostList posts={posts} />
</Layout>
