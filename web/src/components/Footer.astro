---
import ShieldIcon from "./icons/ShieldIcon.astro";
import GithubIcon from "./icons/GithubIcon.astro";
import LinkedinIcon from "./icons/LinkedinIcon.astro";
import ExternalLinkIcon from "./icons/ExternalLinkIcon.astro";
import GlyphField from "./overlays/GlyphField.astro";
---

<footer class="relative w-full overflow-hidden py-8 bg-neutral-900 text-center text-sm text-foreground-inverse/80">
	<GlyphField
		sm={{ cols: 16, rows: 9 }}
		md={{ cols: 32, rows: 9 }}
		lg={{ cols: 64, rows: 9 }}
		xl={{ cols: 80, rows: 9 }}
		twoXl={{ cols: 120, rows: 9 }}
	/>
	<div class="relative max-w-2xl mx-auto px-4">
		<div class="flex flex-col items-center">
			<ShieldIcon class="size-6 sm:size-8 shrink-0 mb-6" />
			<div class="flex flex-col items-center gap-1">
				<p class="font-mono">Built with Astro &middot; Strapi &middot; Neon</p>
				<p>Content managed headlessly, site rebuilds on publish</p>
			</div>
		</div>

		<div class="mt-6 flex flex-wrap items-center justify-center gap-3">
			<a
				class="inline-flex items-center gap-x-2 border border-foreground-inverse/30 bg-neutral-900 px-4 py-2 text-foreground-inverse transition-colors hover:bg-foreground-inverse/10"
				target="_blank"
				rel="noopener noreferrer"
				href="https://github.com/salimdellali/security-news-blog"
			>
				<GithubIcon class="size-4 shrink-0" />
				View on GitHub
				<ExternalLinkIcon class="size-3 shrink-0 self-start" />
			</a>
			<a
				class="inline-flex items-center gap-x-2 border border-foreground-inverse/30 bg-neutral-900 px-4 py-2 text-foreground-inverse transition-colors hover:bg-foreground-inverse/10"
				target="_blank"
				rel="noopener noreferrer"
				href="https://www.linkedin.com/in/dellalisalim/"
			>
				<LinkedinIcon class="size-4 shrink-0" />
				Salim Dellali
				<ExternalLinkIcon class="size-3 shrink-0 self-start" />
			</a>
		</div>
	</div>
</footer>
