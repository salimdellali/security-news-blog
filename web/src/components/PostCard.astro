---
interface Props {
	slug: string;
	title: string;
	excerpt: string;
	publishedAt: string;
	updatedAt: string;
	authorName: string;
}

const { slug, title, excerpt, publishedAt, updatedAt, authorName } = Astro.props;

const dateFormat: Intl.DateTimeFormatOptions = {
	year: "numeric",
	month: "short",
	day: "numeric",
	timeZone: "America/Toronto",
};
const publishedDate = new Date(publishedAt).toLocaleDateString("en-US", dateFormat);
const updatedDate = new Date(updatedAt).toLocaleDateString("en-US", dateFormat);
const wasUpdated = new Date(updatedAt) > new Date(publishedAt);
---

<article class="flex h-full flex-col gap-2 border border-border p-6 transition-shadow hover:shadow-md">
	<h2 class="font-mono text-lg font-semibold">
		<a class="hover:text-primary-hover" href={`/posts/${slug}`}>{title}</a>
	</h2>
	<p class="text-base text-muted-foreground-1">{excerpt}</p>

	<div class="mt-auto flex flex-col gap-3 pt-4 sm:flex-row sm:items-end sm:justify-between sm:gap-x-4 sm:pt-0">
		<p class="text-xs text-muted-foreground">
			Published by {authorName} &middot; {publishedDate}
			{wasUpdated && <> &middot; Last updated {updatedDate}</>}
		</p>

		<a
			class="flex items-center justify-center gap-x-1 bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary-hover sm:inline-flex sm:w-auto sm:shrink-0"
			href={`/posts/${slug}`}
		>
			Quick read →
		</a>
	</div>
</article>
