---
interface Props {
	title: string;
	tagline: string;
}

const { title, tagline } = Astro.props;
---

<header class="w-full py-6 bg-primary-400">
	<nav class="max-w-2xl mx-auto px-4 flex flex-col items-center gap-1">
		<a class="font-mono text-2xl sm:text-4xl font-semibold text-center text-foreground-inverse focus:outline-hidden focus:opacity-80" href="/">
			{title}
		</a>
		<p class="text-sm italic sm:tracking-[0.2em] text-center text-foreground-inverse">{tagline}</p>
	</nav>
</header>
