---
import ShieldIcon from "./icons/ShieldIcon.astro";
import GlyphField from "./overlays/GlyphField.astro";

interface Props {
	title: string;
	tagline: string;
}

const { title, tagline } = Astro.props;
---

<header class="relative w-full overflow-hidden py-6 bg-neutral-900">
	<GlyphField
		sm={{ cols: 16, rows: 4 }}
		md={{ cols: 32, rows: 4 }}
		lg={{ cols: 64, rows: 4 }}
		xl={{ cols: 80, rows: 4 }}
		twoXl={{ cols: 120, rows: 4 }}
	/>
	<nav class="relative max-w-2xl mx-auto px-4 flex flex-col items-center gap-1">
		<a
			class="inline-flex items-center gap-x-2 font-mono text-2xl sm:text-4xl font-semibold text-center text-foreground-inverse focus:outline-hidden focus:opacity-80"
			href="/"
		>
			<ShieldIcon class="size-6 sm:size-8 shrink-0" />
			{title}
			<ShieldIcon class="size-6 sm:size-8 shrink-0" />
		</a>
		<p class="text-sm italic sm:tracking-[0.4em] tracking-widest text-center text-foreground-inverse/80">{tagline}</p>
	</nav>
</header>
